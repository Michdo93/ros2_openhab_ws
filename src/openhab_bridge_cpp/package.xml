<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openhab_bridge_cpp</name>
  <version>2.0.0</version>
  <description>C++ variant of the openHAB bridge (same topics and services), based on cpp-openhab-rest-client.</description>
  <maintainer email="michdo93@users.noreply.github.com">Michael Christian Dörflinger</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>openhab_msgs</depend>
  <!-- cpp-openhab-rest-client: installed (find_package) or fetched from GitHub; needs libcurl -->
  <depend>libcurl-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
