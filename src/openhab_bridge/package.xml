<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openhab_bridge</name>
  <version>2.0.0</version>
  <description>Bridge between openHAB (REST API, Server-Sent Events) and ROS 2, based on python-openhab-rest-client.</description>
  <maintainer email="michdo93@users.noreply.github.com">Michael Christian Dörflinger</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>openhab_msgs</exec_depend>
  <!-- pip install python-openhab-rest-client (no rosdep key) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
